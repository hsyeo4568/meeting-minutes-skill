# Local machine paths for sync-public.py — never commit.
sync-config.local.json

# Stray build/diff artifacts that must never reach the public repo.
# (git add -A in sync-public.py would otherwise stage anything here.)
*mm_diff*
*.tmp
*.bak
*.local.json
__pycache__/

# Stop-hook state. `.sync-blocked` quotes the lines the leak gate rejected —
# i.e. the org/people tokens themselves — so it must never be committable here.
.sync-blocked
.last-autosync
